DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=studyflow
DB_AUTO_CREATE_TABLES=true
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=180
HYBRID_CLOUD_FALLBACK_ENABLED=true
HYBRID_PREFER_CLOUD=true
HYBRID_CLOUD_API_KEY=YOUR_KEY
HYBRID_CLOUD_MODEL=gpt-4o
STUDY_MODES_CLOUD_FIRST=true
SUMMARY_PROVIDER=auto
OLLAMA_SUMMARY_MAX_INPUT_CHARS=72000
OLLAMA_SUMMARY_TEMPERATURE=0.2
SUMMARY_CHUNKED=true
SUMMARY_CHUNK_MIN_WORDS=450
SUMMARY_CHUNK_WORDS=800
SUMMARY_CHUNK_WORD_OVERLAP=120
SUMMARY_CHUNK_MAX_CHARS=16000
PDF_EXTRACT_BACKEND=pymupdf
OLLAMA_COACH=true
SUMMARY_TWO_PASS=true
SUMMARY_FINAL_POLISH=true
SUMMARY_RETEACH_GATE=true
QUIZ_PROVIDER=openai
OLLAMA_QUIZ_MODEL=phi3:mini
